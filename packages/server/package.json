{
  "name": "@deepidv/server",
  "version": "1.2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "agentPay": [
        "./dist/agentPay/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agentPay": {
      "import": {
        "types": "./dist/agentPay/index.d.ts",
        "default": "./dist/agentPay/index.js"
      },
      "require": {
        "types": "./dist/agentPay/index.d.cts",
        "default": "./dist/agentPay/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepidv/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "msw": "^2.12.14",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
